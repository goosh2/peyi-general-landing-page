# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase service-role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for sending confirmation emails
RESEND_API_KEY=

# Cal.com event URL revealed only after a visitor confirms their email
CALCOM_EVENT_URL=

# Secret used to HMAC-sign short-lived confirmation tickets (use a long random string)
BOOKING_TOKEN_SECRET=

# Salt mixed into IP hashes before storage (use a long random string)
IP_HASH_SALT=

# Public site origin used to build confirmation links (e.g. https://www.peyiai.com)
SITE_URL=
